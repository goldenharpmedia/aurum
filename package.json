{
  "name": "aurum-css",
  "version": "1.3.0",
  "description": "Lightweight CSS utility framework using data-au attributes.",
  "style": "dist/au.css",
  "exports": {
    ".": "./dist/au.css",
    "./css": "./dist/au.css",
    "./reset": "./dist/au.reset.css",
    "./normalize": "./dist/au.normalize.css",
    "./flex": "./dist/au.flex.css",
    "./package.json": "./package.json"
